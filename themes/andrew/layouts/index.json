{{- $pages := slice -}}
{{- range site.RegularPages -}}
  {{- $pages = $pages | append (dict
    "title"     .Title
    "permalink" .Permalink
    "section"   .Section
    "summary"   (.Summary | plainify)
    "content"   (.Content | plainify | truncate 2000)
    "date"      (.Date.Format "2006-01-02")
  ) -}}
{{- end -}}
{{- $pages | jsonify -}}
